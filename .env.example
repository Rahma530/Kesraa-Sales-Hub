# Postgres connection string — use a managed Postgres (Supabase, Neon, RDS...) in production
DATABASE_URL="postgresql://user:password@localhost:5432/telesales_crm?schema=public"

# NextAuth
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Shared secret for /api/webhooks/meeting — must match the value configured
# in the AI meeting-notetaker tool (e.g. Fireflies.ai) as a custom header
# "x-webhook-secret" or a "?secret=" query parameter on the webhook URL.
# Without this set, the webhook rejects every request.
AI_WEBHOOK_SECRET="generate-with: openssl rand -base64 32"
