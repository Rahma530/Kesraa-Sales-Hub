# Postgres connection strings — use a managed Postgres (Supabase, Neon, RDS...) in production
#
# DATABASE_URL: the connection the running app uses (Supabase's pooled
# "Transaction" connection, port 6543). Locally, a plain direct URL is fine.
DATABASE_URL="postgresql://user:password@localhost:5432/telesales_crm?schema=public"
#
# DIRECT_URL: a non-pooled connection (port 5432), used only when running
# `prisma migrate deploy`/`migrate dev`. Required on Supabase — its pooler
# doesn't support what migrations need. Locally this can be the same value
# as DATABASE_URL.
DIRECT_URL="postgresql://user:password@localhost:5432/telesales_crm?schema=public"

# NextAuth
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# --- Real meeting-recording integration (Fireflies + Google Calendar + Gemini) ---
#
# FIREFLIES_API_KEY: from Fireflies → Settings → Developer Settings.
# Used both to invite the recording bot (addToLiveMeeting) and to fetch the
# finished transcript/summary (transcript query) after the meeting.
FIREFLIES_API_KEY="your-fireflies-api-key"
#
# FIREFLIES_WEBHOOK_SECRET: the exact "Signing Secret" value you set on
# Fireflies' Webhooks page (Integrations → Webhooks → Default Configuration).
# Fireflies signs every webhook delivery with this ("x-hub-signature" header,
# HMAC-SHA256 of the raw body) — without a matching value here, every
# incoming webhook is rejected (fails closed) before touching the database.
FIREFLIES_WEBHOOK_SECRET="the-same-signing-secret-you-set-in-fireflies"
#
# Google Calendar — creates the real Google Meet link when Sales clicks
# "Create Meeting". Works with any free Gmail account; no paid Google
# Workspace needed. See the setup steps at the top of src/lib/googleCalendar.ts
# (Google Cloud Console → enable Calendar API AND Meet API → OAuth Client ID →
# OAuth Playground → exchange for a refresh token with BOTH scopes:
# calendar.events and meetings.space.created).
#
# The meetings.space.created scope is what lets us create the Meet link with
# "open access" (no host-approval "knocking" screen) instead of Calendar's
# default, which makes every Sales rep wait to be let in. A refresh token
# generated without that scope still works for creating meetings — it just
# silently falls back to the old knock-to-join behavior.
GOOGLE_OAUTH_CLIENT_ID="xxxx.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET="xxxx"
GOOGLE_OAUTH_REFRESH_TOKEN="xxxx"
#
# Gemini — free-tier AI model used to translate the meeting summary to
# Arabic and generate follow-up recommendations for Sales. Get a free key
# (no billing account needed) at https://aistudio.google.com/apikey.
GEMINI_API_KEY="your-gemini-api-key"
# GEMINI_MODEL: optional override. Defaults to "gemini-2.5-flash" (confirmed
# free-tier as of Nov 2026) if not set. Check https://aistudio.google.com
# for the current free model names if you'd rather use a newer one.
# GEMINI_MODEL="gemini-2.5-flash"

# Shared secret for the OLD /api/webhooks/meeting shared-secret scheme —
# no longer used now that the webhook verifies Fireflies' own HMAC signature
# (FIREFLIES_WEBHOOK_SECRET above) instead. Safe to remove once the new
# integration is confirmed working.
AI_WEBHOOK_SECRET="generate-with: openssl rand -base64 32"

# Resend (https://resend.com) — sends the "forgot password" reset email.
# RESEND_API_KEY: from https://resend.com/api-keys
# EMAIL_FROM: a sender address on a domain verified in Resend, e.g.
#   "Kesra CRM <no-reply@kesraa.com>". Until the domain is verified, Resend
#   only delivers to the account owner's own email (useful for testing).
RESEND_API_KEY="re_xxxxxxxx"
EMAIL_FROM="Kesra CRM <no-reply@kesraa.com>"
