# Postgres connection strings — use a managed Postgres (Supabase, Neon, RDS...) in production
#
# DATABASE_URL: the connection the running app uses (Supabase's pooled
# "Transaction" connection, port 6543). Locally, a plain direct URL is fine.
DATABASE_URL="postgresql://user:password@localhost:5432/telesales_crm?schema=public"
#
# DIRECT_URL: a non-pooled connection (port 5432), used only when running
# `prisma migrate deploy`/`migrate dev`. Required on Supabase — its pooler
# doesn't support what migrations need. Locally this can be the same value
# as DATABASE_URL.
DIRECT_URL="postgresql://user:password@localhost:5432/telesales_crm?schema=public"

# NextAuth
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Shared secret for /api/webhooks/meeting — must match the value configured
# in the AI meeting-notetaker tool (e.g. Fireflies.ai) as a custom header
# "x-webhook-secret" or a "?secret=" query parameter on the webhook URL.
# Without this set, the webhook rejects every request.
AI_WEBHOOK_SECRET="generate-with: openssl rand -base64 32"

# Resend (https://resend.com) — sends the "forgot password" reset email.
# RESEND_API_KEY: from https://resend.com/api-keys
# EMAIL_FROM: a sender address on a domain verified in Resend, e.g.
#   "Kesra CRM <no-reply@kesraa.com>". Until the domain is verified, Resend
#   only delivers to the account owner's own email (useful for testing).
RESEND_API_KEY="re_xxxxxxxx"
EMAIL_FROM="Kesra CRM <no-reply@kesraa.com>"
