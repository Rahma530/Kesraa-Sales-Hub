// ============================================================
// TeleSales CRM — Prisma Schema
// Roles: ADMIN, HEAD_OF_SALES, TELE_SALES, SALES
// ============================================================

generator client {
  provider = "prisma-client-js"
  // Back to the default "library" engine (embedded in the Node.js
  // process). We previously switched this to "binary" to work around a
  // Hostinger build crash, but the "binary" engine runs as a separate
  // long-lived background process — something Hostinger's managed Web
  // App hosting does not support (same restriction that blocks the
  // WhatsApp/Puppeteer feature). The actual build crash was caused by
  // PrismaClient being constructed eagerly at module load time (see
  // src/lib/prisma.ts); now that it's constructed lazily on first real
  // use, the default engine no longer touches the build at all.
}

datasource db {
  provider  = "postgresql"
  // DATABASE_URL: pooled connection (port 6543) — used by the running app.
  // DIRECT_URL: direct connection (port 5432) — used only when Prisma
  // applies migrations. Supabase's connection pooler doesn't support the
  // prepared-statement protocol migrations need, so this must point at
  // the non-pooled URL or `prisma migrate deploy` will fail or hang.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}













model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  username      String   @unique
  // Null until the employee sets their own password via their invite link.
  passwordHash  String?
  // Invitation system: set when an account is created (or an invite is
  // resent), cleared once the employee sets their password.
  inviteToken          String?   @unique
  inviteTokenExpiresAt DateTime?
  // Forgot-password flow: set when the employee requests a reset email,
  // cleared once they set a new password or the link expires.
  passwordResetToken          String?   @unique
  passwordResetTokenExpiresAt DateTime?
  role          String
  isActive      Boolean  @default(true)
  lastActiveAt  DateTime?
  phone         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Leads currently assigned to this user (as tele-sales or sales owner)
  assignedLeads Lead[]        @relation("AssignedTo")
  createdLeads  Lead[]        @relation("CreatedBy")
  followUps     FollowUp[]
  meetings      Meeting[]
  activities    Activity[]
  uploadBatches UploadBatch[]
  notifications Notification[]
  sentMessages  ChatMessage[] @relation("SentMessages")
  receivedMessages ChatMessage[] @relation("ReceivedMessages")
  chatGroups    ChatGroup[]   @relation("GroupCreator")
  groupMemberships ChatGroupMember[]

  @@index([role])
}

model Lead {
  id             String     @id @default(cuid())
  name           String
  phone          String     @unique
  email          String?
  company        String?
  need           String? // احتياج العميل
  interestReason String? // سبب اهتمامه
  notes          String?
  storeUrl       String? // لينك متجر العميل
  socialMediaUrl String? // رابط السوشيال ميديا
  contractUrl    String? // رابط العقد المرفوع

  status String @default("NEW")
  salesStatus String?
  tier String   @default("LEAD")
  source String @default("MANUAL")

  // Ownership — moves from Tele-Sales owner to Sales owner on transfer
  assignedToId String?
  assignedTo   User?   @relation("AssignedTo", fields: [assignedToId], references: [id])

  // Stage owner type, useful for filtering "who currently owns this"
  currentStage String @default("TELE_SALES")

  createdById String
  createdBy   User   @relation("CreatedBy", fields: [createdById], references: [id])

  uploadBatchId String?
  uploadBatch   UploadBatch? @relation(fields: [uploadBatchId], references: [id])

  transferredAt DateTime?
  closedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  followUps  FollowUp[]
  meetings   Meeting[]
  activities Activity[]

  @@index([assignedToId])
  @@index([status])
  @@index([tier])
  @@index([currentStage])
}

// A follow-up scheduled by a Tele-Sales or Sales employee
model FollowUp {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  scheduledDate DateTime?
  notes         String?
  details       String?

  isCompleted Boolean   @default(false)
  completedAt DateTime?

  // Set once a "your follow-up is due" Notification has been created for
  // this row, so the due-check (run on every tele-sales/sales dashboard
  // load) doesn't notify the same employee twice for the same follow-up.
  reminderSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([scheduledDate])
  @@index([isCompleted])
}

model Meeting {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  // The Sales (or Tele-Sales, before transfer) employee who owns the meeting
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  scheduledAt DateTime
  status String @default("SCHEDULED")

  result String? // نتيجة الـ Meeting
  notes  String?

  // The real Google Meet link created via Calendar API when this meeting
  // was scheduled (the "Create Meeting" button), and the Google Calendar
  // event id it belongs to (useful for looking the event back up, e.g. to
  // reschedule or cancel it).
  meetingLink     String?
  calendarEventId String?

  // Fireflies' own id for the bot session we asked to join meetingLink
  // (via the addToLiveMeeting mutation). This is what the incoming webhook
  // reports back, and what we use to fetch the finished transcript/summary.
  firefliesMeetingId String?

  recordingUrl String? // رابط معاينة التسجيل/التفريغ في داشبورد Fireflies
  transcript   String? // التفريغ الصوتي الكامل (Transcript) الخام من Fireflies، زي ما هو
  aiAnalysis   String? // الملخص الأصلي (إنجليزي) من Fireflies
  aiTranslation     String? // ترجمة الملخص للعربي (عبر Gemini)
  aiRecommendations String? // اقتراحات المتابعة المقترحة من الـ AI (عبر Gemini)
  // نسخة مصححة من الـ transcript (عبر Gemini) — بتصحح خلط العربي/الإنجليزي
  // والكلمات الغامضة بسبب جودة الصوت، من غير ما تلخّص أو تختصر المحتوى.
  // بتتعرض بدل الخام لما تكون موجودة.
  correctedTranscript String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([ownerId])
  @@index([scheduledAt])
  @@index([status])
  @@index([firefliesMeetingId])
}

// Full audit trail — every action on a lead, visible to Admin/Head of Sales
model Activity {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  type String
  message String

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([createdAt])
}

// Records each Excel/CSV upload — for traceability of bulk distribution
// status: PENDING (being processed in the background) -> DONE | FAILED
model UploadBatch {
  id            String   @id @default(cuid())
  fileName      String
  totalLeads    Int
  processedLeads Int     @default(0)
  skippedLeads   Int     @default(0)
  status        String   @default("DONE") // PENDING | DONE | FAILED — large uploads start as PENDING
  errorMessage  String?
  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])
  createdAt  DateTime @default(now())

  leads Lead[]

  @@index([status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model ChatMessage {
  id         String   @id @default(cuid())
  content    String
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String?
  receiver   User?     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  groupId    String?
  group      ChatGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([senderId, receiverId])
  @@index([groupId])
  @@index([createdAt])
}

model ChatGroup {
  id          String   @id @default(cuid())
  name        String
  createdAt   DateTime @default(now())
  createdById String
  createdBy   User     @relation("GroupCreator", fields: [createdById], references: [id])

  members     ChatGroupMember[]
  messages    ChatMessage[]
}

model ChatGroupMember {
  id        String   @id @default(cuid())
  groupId   String
  group     ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())

  @@unique([groupId, userId])
}
